# Managed by dpkg as a configuration file. Edit with sudoedit, then restart:
# sudo systemctl restart prowlarr-mobile
# Read by systemd; values are passed to the service as environment variables.

HOST=0.0.0.0
PORT=8888

PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=

QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# File movement is optional. These paths are local to this app's machine,
# not automatically the paths on a remote qBittorrent server.
# Leave the placeholder paths until you configure and test file permissions.
TORRENTS_DIR=/path/to/your/torrent/downloads
MOVIES_DIR=/path/to/your/media-server/movies
TV_SHOWS_DIR=/path/to/your/media-server/tv-shows
